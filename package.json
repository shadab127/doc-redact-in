{
  "name": "doc-redact-in",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "description": "Client-side, mobile-first, open-source redactor for Indian ID documents (Aadhaar, PAN, passport, QR, faces).",
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/build-schema.mjs && node scripts/prepare-vendor-assets.mjs",
    "build": "next build",
    "postbuild": "node scripts/csp-hashes.mjs",
    "start": "next start",
    "preview": "node scripts/preview.mjs",
    "schema": "node scripts/build-schema.mjs",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:private": "node scripts/test-private-samples.mjs",
    "test:e2e:production": "npm run build && E2E_PRODUCTION=1 playwright test"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.35",
    "jsqr": "^1.4.0",
    "next": "15.5.27",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.7.76",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tesseract.js": "5.1.1",
    "zxing-wasm": "^3.0.2"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "20.19.43",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "eslint": "8.57.0",
    "eslint-config-next": "14.2.35",
    "typescript": "5.5.4",
    "vitest": "4.1.11"
  },
  "overrides": {
    "postcss": "8.5.29",
    "@mapbox/node-pre-gyp": "2.0.3",
    "@next/eslint-plugin-next": {
      "glob": "10.5.0"
    }
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
